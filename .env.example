# Local mode is the default and needs nothing below.
COPILOT_LLM=local            # local | azure
COPILOT_RETRIEVER=local      # local | azure

# Azure OpenAI (memo narrative only; decisions stay deterministic)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Search (hybrid keyword + vector retrieval over guidelines)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=uw-guidelines
